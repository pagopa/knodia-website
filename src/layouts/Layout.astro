---
import Button from '../components/Button.astro'
import '../styles/global.css'
const { title } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <header class="flex w-full items-center justify-between p-10">
            <span>Knodia</span>
            <nav>Navigation</nav>
            <Button href="/what-is-knodia">Get Started</Button>
        </header>
        <main>
            <slot />
        </main>
        <footer>Footer</footer>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
