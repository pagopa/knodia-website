---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="Company details">
    <section
        class="bg-neutral-white px-6 pt-36 pb-20 xl:px-[141px] xl:pt-36 xl:pb-32"
    >
        <div class="mx-auto w-full max-w-[1158px]">
            <h1
                class="text-[40px] leading-[48px] font-medium text-primary-violet xl:text-[56px] xl:leading-[64px]"
            >
                Company details
            </h1>

            <div class="mt-8 max-w-[805px] xl:mt-14">
                <h2
                    class="text-[24px] leading-[32px] font-medium text-primary-violet xl:text-[28px] xl:leading-[36px]"
                >
                    PagoPA S.p.A.
                </h2>

                <p
                    class="mt-7 text-[18px] leading-[28px] text-neutral-graphite"
                >
                    Registered office:
                </p>
                <p
                    class="text-[18px] leading-[28px] font-bold text-neutral-graphite"
                >
                    Piazza Colonna 370, 00187 Rome, Italy
                </p>

                <p
                    class="mt-7 text-[18px] leading-[28px] text-neutral-graphite"
                >
                    VAT / Tax Code:
                </p>
                <p
                    class="text-[18px] leading-[28px] font-bold text-neutral-graphite"
                >
                    15376371009
                </p>

                <p
                    class="mt-7 text-[18px] leading-[28px] text-neutral-graphite"
                >
                    Share Capital:
                </p>
                <p
                    class="text-[18px] leading-[28px] font-bold text-neutral-graphite"
                >
                    €1,000,000 fully paid-in
                </p>
            </div>
        </div>
    </section>
</Layout>
