    ogDescription="Knodia supports trusted cross-border interaction across Europe through a shared federated model."
    schemaType="WebPage"
>
    <Hero />
    <SubHeroBanner />
    <DomainsConnect />
    <SupportAudience />
    <InteroperabilityPaths />
    <WhatMakesKnodiaDifferent />
    <FoundationsBanner />
    <UseCaseSpotlight />
    <CtaBanner />
</Layout>
