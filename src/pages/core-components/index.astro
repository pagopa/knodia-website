---
import Layout from '../../layouts/Layout.astro'
import Button from '../../components/Button'
import Icon, {
    iconShowcaseColumns,
    ArrowRightIcon,
    ChevronDownIcon,
} from '../../components/Icon'

const showcaseHref = '#'

const stateRows = [
    { label: 'Default', state: 'default', disabled: false },
    { label: 'Mouseover', state: 'hover', disabled: false },
    { label: 'Active', state: 'active', disabled: false },
    { label: 'Disabled', state: 'disabled', disabled: true },
] as const

const standardColumns = [
    { label: 'Contained', props: { href: showcaseHref, variant: 'contained' } },
    { label: 'Outlined', props: { href: showcaseHref, variant: 'outlined' } },
    {
        label: 'Contained contrast',
        props: { href: showcaseHref, tone: 'contrast', variant: 'contained' },
    },
    {
        label: 'Outlined contrast',
        props: { href: showcaseHref, tone: 'contrast', variant: 'outlined' },
    },
    {
        label: 'Naked small',
        props: { href: showcaseHref, size: 'small', variant: 'naked' },
    },
    {
        label: 'Naked contrast small',
        props: {
            href: showcaseHref,
            size: 'small',
            tone: 'contrast',
            variant: 'naked',
        },
    },
    {
        label: 'Naked medium',
        props: { href: showcaseHref, size: 'medium', variant: 'naked' },
    },
    {
        label: 'Naked contrast medium',
        props: {
            href: showcaseHref,
            size: 'medium',
            tone: 'contrast',
            variant: 'naked',
        },
    },
] as const

const iconColumns = [
    {
        label: 'Contained',
        props: {
            href: showcaseHref,
            icon: ArrowRightIcon,
            variant: 'contained',
        },
    },
    {
        label: 'Outlined',
        props: {
            href: showcaseHref,
            icon: ArrowRightIcon,
            variant: 'outlined',
        },
    },
    {
        label: 'Contained contrast',
        props: {
            href: showcaseHref,
            icon: ArrowRightIcon,
            tone: 'contrast',
            variant: 'contained',
        },
    },
    {
        label: 'Outlined contrast',
        props: {
            href: showcaseHref,
            icon: ArrowRightIcon,
            tone: 'contrast',
            variant: 'outlined',
        },
    },
    {
        label: 'Naked small',
        props: {
            href: showcaseHref,
            icon: ChevronDownIcon,
            size: 'small',
            variant: 'naked',
        },
    },
] as const
---

<Layout title="Core Components">
    <section class="space-y-16 px-4 py-8 sm:px-6 lg:px-8">
        <div
            class="mx-auto max-w-[1500px] rounded-[var(--radius-showcase)] bg-[var(--color-showcase-surface)] px-6 py-10 sm:px-8 lg:px-12 lg:py-16"
        >
            <div class="space-y-16">
                <div class="space-y-8">
                    <h1
                        class="font-heading text-[length:var(--text-heading-lg)] leading-[var(--leading-heading-lg)] font-normal text-[var(--color-showcase-accent)] uppercase"
                    >
                        Buttons
                    </h1>
                    <div class="overflow-x-auto pb-2">
                        <div
                            class="grid min-w-[var(--showcase-standard-min-width)] grid-cols-[var(--showcase-label-column)_repeat(8,minmax(0,1fr))] gap-x-[var(--showcase-column-gap)] gap-y-[var(--showcase-row-gap)]"
                        >
                            <div></div>
                            {
                                standardColumns.map((column) => (
                                    <h2 class="font-heading text-[length:var(--text-heading-md)] leading-[var(--leading-heading-md)] font-normal text-[var(--color-showcase-accent)]">
                                        {column.label}
                                    </h2>
                                ))
                            }

                            {
                                stateRows.map((row) => (
                                    <>
                                        <p class="font-heading text-[length:var(--text-heading-md)] leading-[var(--leading-heading-md)] font-normal text-[var(--color-showcase-accent)]">
                                            {row.label}
                                        </p>
                                        {standardColumns.map((column) => (
                                            <div class="flex items-center">
                                                <Button
                                                    {...column.props}
                                                    disabled={row.disabled}
                                                    state={row.state}
                                                >
                                                    Button
                                                </Button>
                                            </div>
                                        ))}
                                    </>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div class="space-y-8">
                    <h2
                        class="font-heading text-[length:var(--text-heading-lg)] leading-[var(--leading-heading-lg)] font-normal text-[var(--color-showcase-accent)] uppercase"
                    >
                        Buttons With Icon
                    </h2>
                    <div class="overflow-x-auto pb-2">
                        <div
                            class="grid min-w-[var(--showcase-icon-min-width)] grid-cols-[var(--showcase-label-column)_repeat(6,minmax(0,1fr))] gap-x-[var(--showcase-column-gap)] gap-y-[var(--showcase-row-gap)]"
                        >
                            <div></div>
                            {
                                iconColumns.map((column) => (
                                    <h3 class="font-heading text-[length:var(--text-heading-md)] leading-[var(--leading-heading-md)] font-normal text-[var(--color-showcase-accent)]">
                                        {column.label}
                                    </h3>
                                ))
                            }
                            <h3
                                class="font-heading text-[length:var(--text-heading-md)] leading-[var(--leading-heading-md)] font-normal text-[var(--color-showcase-accent)]"
                            >
                                Naked + Left icon
                            </h3>

                            {
                                stateRows.map((row) => (
                                    <>
                                        <p class="font-heading text-[length:var(--text-heading-md)] leading-[var(--leading-heading-md)] font-normal text-[var(--color-showcase-accent)]">
                                            {row.label}
                                        </p>
                                        {iconColumns.map((column) => (
                                            <div class="flex items-center">
                                                <Button
                                                    {...column.props}
                                                    disabled={row.disabled}
                                                    state={row.state}
                                                >
                                                    Button
                                                </Button>
                                            </div>
                                        ))}
                                        <div class="flex items-center">
                                            {row.state === 'default' ? (
                                                <Button
                                                    href="#"
                                                    variant="feature"
                                                >
                                                    Page title
                                                </Button>
                                            ) : (
                                                <span class="h-[var(--feature-badge-size)]" />
                                            )}
                                        </div>
                                    </>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div aria-label="Icons showcase" class="mx-auto max-w-[1500px]">
            <div
                class="grid grid-cols-1 gap-x-[var(--icon-showcase-column-gap)] gap-y-12 md:grid-cols-2 xl:grid-cols-4"
            >
                {
                    iconShowcaseColumns.map((column) => (
                        <div class="space-y-[var(--icon-showcase-row-gap)]">
                            {column.map((iconName) => (
                                <div class="flex items-center gap-[var(--icon-showcase-item-gap)] text-neutral-black">
                                    <Icon name={iconName} size="showcase" />
                                    <span class="font-icon-label text-[length:var(--icon-showcase-label-size)] leading-normal font-medium text-neutral-black">
                                        {iconName}
                                    </span>
                                </div>
                            ))}
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
