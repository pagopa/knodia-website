---
import {
    executiveSummaryLink,
    prototypeLink,
    whitepaperLink,
} from '../../constants'
import Button from '../Button.astro'
import {
    headerCta,
    headerMenuGroups,
    headerPrimaryLinks,
} from '../Header/navigation'
import type { IconName } from '../Icon'

function findGroupItemHref(
    groupId: string,
    itemId: string,
    fallbackHref: string
) {
    return (
        headerMenuGroups
            .find((group) => group.id === groupId)
            ?.items.find((item) => item.id === itemId)?.href ?? fallbackHref
    )
}

function findPrimaryHref(linkId: string, fallbackHref: string) {
    return (
        headerPrimaryLinks.find((link) => link.id === linkId)?.href ??
        fallbackHref
    )
}
const preFooterLinks: {
    label: string
    href: string
    icon: IconName
    download?: boolean
}[] = [
    {
        label: 'Request prototype access',
        href: prototypeLink.href,
        icon: 'open_in_new',
    },
    {
        label: whitepaperLink.label,
        href: whitepaperLink.href,
        icon: 'open_in_new',
    },
    {
        label: executiveSummaryLink.label,
        href: executiveSummaryLink.href,
        icon: 'open_in_new',
    },
] as const

const footerSections = [
    {
        links: [
            {
                label: 'What is Knodia',
                href: findGroupItemHref(
                    'overview',
                    'whats-knodia',
                    '/what-is-knodia'
                ),
            },
            {
                label: 'Why Knodia',
                href: findGroupItemHref(
                    'overview',
                    'why-knodia',
                    '/why-knodia'
                ),
            },
            {
                label: 'Core Functions',
                href: findGroupItemHref(
                    'overview',
                    'core-functions',
                    '/core-functions'
                ),
            },
        ],
        title: 'Overview',
    },
    {
        links: [
            {
                label: 'Technology',
                href: findGroupItemHref('product', 'technology', '/technology'),
            },
            {
                label: 'Security',
                href: findGroupItemHref('product', 'security', '/security'),
            },
            {
                label: 'Compliance',
                href: findGroupItemHref('product', 'compliance', '/compliance'),
            },
            {
                label: 'Governance',
                href: findGroupItemHref('product', 'governance', '/governance'),
            },
        ],
        title: 'Product',
    },
] as const

const standaloneFooterLinks = [
    {
        label: 'Use Cases',
        href: findPrimaryHref('use-cases', '/#use-cases'),
    },
    {
        label: 'Resources',
        href: findPrimaryHref('resources', '/resources'),
    },
] as const

const accessibilityStatementEnPdfPath =
    '/docs/2026_07_02_knodia_accessibility_statement_en.pdf'

type FooterLegalLink = {
    label: string
    href: string
    download?: boolean
}

const desktopLegalLinks: FooterLegalLink[] = [
    { label: 'Privacy Policy', href: '/privacy-policy' },
    { label: 'Legal Notes', href: '/legal-notes' },
    {
        label: 'Accessibility statement (IT)',
        href: 'https://form.agid.gov.it/5N2TR557/Knodia_(public_website)/dichiarazione',
    },
    {
        label: 'Accessibility statement (EN)',
        href: accessibilityStatementEnPdfPath,
        download: true,
    },
] as const

const mobileLegalLinks: FooterLegalLink[] = [
    { label: 'Privacy Policy', href: '/privacy-policy' },
    { label: 'Legal Notes', href: '/legal-notes' },
    {
        label: 'Accessibility statement (IT)',
        href: 'https://form.agid.gov.it/5N2TR557/Knodia_(public_website)/dichiarazione',
    },
    {
        label: 'Accessibility statement (EN)',
        href: accessibilityStatementEnPdfPath,
        download: true,
    },
] as const

const focusRingClass =
    'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-white'
const buttonFocusOffsetClass = 'focus-visible:outline-offset-4'
const preFooterLinkClass = `${buttonFocusOffsetClass} justify-center [&>span]:gap-1.5 xl:[&>span]:gap-2 [&>span>span:first-child]:text-center [&>span>span:first-child]:text-[13px] [&>span>span:first-child]:leading-[19.5px] xl:[&>span>span:first-child]:text-[16px] xl:[&>span>span:first-child]:leading-6 [&>span>span:last-child]:size-[14px] [&>span>span:last-child]:text-[14px] xl:[&>span>span:last-child]:size-[18px] xl:[&>span>span:last-child]:text-[18px]`
const footerTitleClass =
    'text-[16px] leading-6 font-medium uppercase tracking-normal text-neutral-surface-gray'
const footerLinkBaseClass = `${buttonFocusOffsetClass} text-neutral-white [&>span>span]:text-[16px] [&>span>span]:leading-6 [&>span>span]:font-medium`
const footerCtaClass = `${buttonFocusOffsetClass} w-[211px] rounded-[8px] px-[52px] xl:w-auto xl:px-4 [&>span]:gap-[7px] xl:[&>span]:gap-2 [&>span>span:first-child]:text-[15px] [&>span>span:first-child]:leading-[22.5px] xl:[&>span>span:first-child]:text-[18px] xl:[&>span>span:first-child]:leading-7 [&>span>span:last-child]:size-[16px] [&>span>span:last-child]:text-[16px] xl:[&>span>span:last-child]:size-[24px] xl:[&>span>span:last-child]:text-[24px]`
const desktopLegalLinkClass = `${buttonFocusOffsetClass} text-neutral-white [&>span>span]:text-[14px] [&>span>span]:leading-5 [&>span>span]:font-medium`
const mobileLegalLinkClass = `${buttonFocusOffsetClass} text-neutral-surface-gray [&>span>span]:text-[12px] [&>span>span]:leading-[18px] [&>span>span]:font-normal`
---

<footer class="mt-auto">
    <div class="bg-primary-violet px-6 py-10 xl:px-35.25 xl:py-2.75">
        <div
            class="mx-auto flex w-full max-w-289.5 flex-col items-center gap-6 xl:flex-row xl:justify-between xl:gap-22"
        >
            <div
                class="flex w-full flex-col items-center gap-4 xl:w-auto xl:flex-row xl:gap-7.75"
            >
                {
                    preFooterLinks.map((link) => (
                        <Button
                            class={`${preFooterLinkClass} ${focusRingClass}`}
                            href={link.href}
                            icon={link.icon}
                            size="small"
                            tone="contrast"
                            variant="naked"
                            download={link.download}
                        >
                            {link.label}
                        </Button>
                    ))
                }
            </div>

            <Button
                class={footerCtaClass}
                href={headerCta.href}
                icon="arrow_forward"
                tone="contrast"
                variant="outlined"
            >
                Get started
            </Button>
        </div>
    </div>
    <div class="bg-deep-violet px-6 pt-10 pb-8 xl:px-35.25 xl:pt-15 xl:pb-12">
        <div
            class="mx-auto flex w-full max-w-98.25 flex-col gap-10 xl:max-w-289.5 xl:gap-13"
        >
            <div
                class="flex flex-col gap-15 xl:flex-row xl:items-start xl:justify-between"
            >
                <a class={focusRingClass} href="/">
                    <img
                        alt="Knodia"
                        class="h-11 w-[124.079px] max-w-none xl:h-14 xl:w-[157.918px]"
                        height="56"
                        src="/brand/knodia-logo-white.svg"
                        width="158"
                    />
                </a>

                <div
                    class="flex flex-col gap-15 xl:flex-row xl:items-start xl:gap-6"
                >
                    <nav
                        aria-label="Footer navigation"
                        class="flex flex-col gap-15 xl:flex-row xl:gap-6"
                    >
                        {
                            footerSections.map((section) => (
                                <section class="w-full max-w-47.75 xl:w-47.75">
                                    <h2 class={footerTitleClass}>
                                        {section.title}
                                    </h2>
                                    <ul class="mt-5 space-y-3">
                                        {section.links.map((link) => (
                                            <li>
                                                <Button
                                                    class={footerLinkBaseClass}
                                                    href={link.href}
                                                    size="small"
                                                    tone="contrast"
                                                    variant="naked"
                                                >
                                                    {link.label}
                                                </Button>
                                            </li>
                                        ))}
                                    </ul>
                                </section>
                            ))
                        }

                        <section class="w-full xl:w-47.75">
                            <ul class="space-y-2.5">
                                {
                                    standaloneFooterLinks.map((link) => (
                                        <li>
                                            <Button
                                                class={footerLinkBaseClass}
                                                href={link.href}
                                                size="small"
                                                tone="contrast"
                                                variant="naked"
                                            >
                                                {link.label}
                                            </Button>
                                        </li>
                                    ))
                                }
                            </ul>
                        </section>
                    </nav>

                    <aside class="flex w-54.75 flex-col gap-16.5">
                        <a
                            class={`${focusRingClass} block`}
                            href="https://commission.europa.eu/index_en"
                            rel="noopener noreferrer"
                            target="_blank"
                            title="Go to EU Commission website"
                        >
                            <img
                                alt="Logo NextGenerationEU"
                                class="h-auto w-full"
                                height="58"
                                src="/brand/eu-funded.png"
                                width="219"
                            />
                        </a>

                        <section>
                            <h2
                                class="text-[12px] leading-5 font-normal text-neutral-surface-gray"
                            >
                                Project implemented and managed by <a
                                    href="https://www.pagopa.it/it/en/homepage/"
                                    rel="noopener noreferrer"
                                    target="_blank"
                                    class={`${focusRingClass} pagopa-link`}
                                    title="Go to PagoPA S.p.A. website"
                                    >PagoPA S.p.A.</a
                                >
                                on behalf of
                            </h2>
                            <div class="mt-4 flex flex-col items-start gap-6">
                                <a
                                    class={focusRingClass}
                                    href="https://innovazione.gov.it/"
                                    rel="noopener noreferrer"
                                    target="_blank"
                                    title="Go to Dipartimento per la trasformazione digitale website"
                                >
                                    <img
                                        alt="Logo Dipartimento per la trasformazione digitale"
                                        class="h-auto w-54.75"
                                        height="34"
                                        src="/brand/dtd-footer-logo.svg"
                                        width="219"
                                    />
                                </a>
                            </div>
                        </section>
                    </aside>
                </div>
            </div>

            <div
                class="hidden items-center gap-6 xl:flex xl:text-[14px] xl:leading-5 xl:text-neutral-white"
            >
                <p
                    class="shrink-0 text-[14px] leading-5 font-normal tracking-[0.35px] text-neutral-white uppercase"
                >
                    &copy; 2026 KNODIA
                </p>
                <div class="flex flex-wrap items-center gap-0">
                    {
                        desktopLegalLinks.map((link, index) => (
                            <>
                                {index > 0 ? (
                                    <span class="px-3 text-neutral-white/80">
                                        ·
                                    </span>
                                ) : null}
                                <Button
                                    class={desktopLegalLinkClass}
                                    href={link.href}
                                    size="small"
                                    tone="contrast"
                                    variant="naked"
                                    download={link.download}
                                >
                                    {link.label}
                                </Button>
                            </>
                        ))
                    }
                </div>
            </div>

            <div class="flex flex-col items-center gap-6 text-center xl:hidden">
                <p
                    class="text-[12px] leading-[18px] font-normal tracking-[0.35px] text-neutral-surface-gray uppercase"
                >
                    © 2026 KNODIA
                </p>
                <div
                    class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2"
                >
                    {
                        mobileLegalLinks.map((link) => (
                            <Button
                                class={mobileLegalLinkClass}
                                href={link.href}
                                size="small"
                                tone="contrast"
                                variant="naked"
                                download={link.download}
                            >
                                {link.label}
                            </Button>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</footer>
