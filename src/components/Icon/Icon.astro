---
import { tv } from 'tailwind-variants'
import type { IconName, IconSize } from './icon'
import { joinClasses } from '../../utils'

type Props = {
    name: IconName
    size?: IconSize
    class?: string
    title?: string
    ariaHidden?: boolean
}

const materialIconRoot = tv({
    base: 'knodia-material-symbol inline-flex shrink-0 items-center justify-center leading-none text-current',
    variants: {
        size: {
            button: 'text-[length:var(--button-icon-size)]',
            'button-small': 'text-[length:var(--button-icon-size-sm)]',
            showcase: 'text-[length:var(--icon-showcase-icon-size)]',
        },
    },
    defaultVariants: {
        size: 'button',
    },
})

const svgIconRoot = tv({
    base: 'inline-block shrink-0 text-current',
    variants: {
        size: {
            button: 'size-[var(--button-icon-size)]',
            'button-small': 'size-[var(--button-icon-size-sm)]',
            showcase: 'size-[var(--icon-showcase-icon-size)]',
        },
    },
    defaultVariants: {
        size: 'button',
    },
})

const {
    ariaHidden = true,
    class: className,
    name,
    size = 'button',
    title,
} = Astro.props as Props

const isDecorative = title == null
---

{
    name === 'source' ? (
        <svg
            aria-hidden={isDecorative ? ariaHidden : undefined}
            aria-label={title}
            class={joinClasses(svgIconRoot({ size }), className)}
            fill="none"
            role={title ? 'img' : undefined}
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
        >
            {title ? <title>{title}</title> : null}
            <path
                d="M6 6.75C6 5.78 6.78 5 7.75 5H13.63L18 9.37V17.25C18 18.22 17.22 19 16.25 19H7.75C6.78 19 6 18.22 6 17.25V6.75Z"
                stroke="currentColor"
                stroke-linejoin="round"
                stroke-width="1.8"
            />
            <path
                d="M13 5V10H18"
                stroke="currentColor"
                stroke-linejoin="round"
                stroke-width="1.8"
            />
            <path
                d="M9 12H15"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-width="1.8"
            />
            <path
                d="M9 15H13.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-width="1.8"
            />
        </svg>
    ) : name === 'topic' ? (
        <svg
            aria-hidden={isDecorative ? ariaHidden : undefined}
            aria-label={title}
            class={joinClasses(svgIconRoot({ size }), className)}
            fill="none"
            role={title ? 'img' : undefined}
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
        >
            {title ? <title>{title}</title> : null}
            <path
                d="M4 20C3.45 20 2.97917 19.8042 2.5875 19.4125C2.19583 19.0208 2 18.55 2 18V6C2 5.45 2.19583 4.97917 2.5875 4.5875C2.97917 4.19583 3.45 4 4 4H9.175C9.44167 4 9.69583 4.05 9.9375 4.15C10.1792 4.25 10.3917 4.39167 10.575 4.575L12 6H20C20.55 6 21.0208 6.19583 21.4125 6.5875C21.8042 6.97917 22 7.45 22 8V18C22 18.55 21.8042 19.0208 21.4125 19.4125C21.0208 19.8042 20.55 20 20 20H4ZM4 18H20V8H11.175L9.175 6H4V18ZM7 16H13C13.2833 16 13.5208 15.9042 13.7125 15.7125C13.9042 15.5208 14 15.2833 14 15C14 14.7167 13.9042 14.4792 13.7125 14.2875C13.5208 14.0958 13.2833 14 13 14H7C6.71667 14 6.47917 14.0958 6.2875 14.2875C6.09583 14.4792 6 14.7167 6 15C6 15.2833 6.09583 15.5208 6.2875 15.7125C6.47917 15.9042 6.71667 16 7 16ZM7 12H17C17.2833 12 17.5208 11.9042 17.7125 11.7125C17.9042 11.5208 18 11.2833 18 11C18 10.7167 17.9042 10.4792 17.7125 10.2875C17.5208 10.0958 17.2833 10 17 10H7C6.71667 10 6.47917 10.0958 6.2875 10.2875C6.09583 10.4792 6 10.7167 6 11C6 11.2833 6.09583 11.5208 6.2875 11.7125C6.47917 11.9042 6.71667 12 7 12Z"
                fill="currentColor"
            />
        </svg>
