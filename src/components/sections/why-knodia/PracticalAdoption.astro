---
import Button from '../../Button.astro'
import Icon from '../../Icon'
import type { IconName } from '../../Icon'
import practicalAdoptionBackground from '../../../assets/backgrounds/why-knodia-practical-adoption-background.png'

type AdoptionCard = {
    icon: IconName
    title: string
    description: string
    href: string
    hrefLabel: string
}

const adoptionCards: AdoptionCard[] = [
    {
        icon: 'device_hub',
        title: 'Data stays with the relevant parties',
        description:
            'Exchanged data remains visible only to the organizations involved in the interaction, rather than being centralized in the framework.',
        href: '/#product-security',
        hrefLabel: 'Explore Security',
    },
    {
        icon: 'system_update_alt',
        title: 'Existing systems can still be used',
        description:
            'Adoption can build on national systems and organizational infrastructures without requiring a single technology stack.',
        href: '/#product-technology',
        hrefLabel: 'Explore Technology',
    },
    {
        icon: 'share',
        title: 'National governance remains in place',
        description:
            'National onboarding, checks and domain-level governance remain under local control, while Knodia supports the shared cross-border layer.',
        href: '/#product-governance',
        hrefLabel: 'Explore Governance',
    },
    {
        icon: 'security',
        title: 'GDPR-ready access',
        description:
            'Privacy and access requirements can be translated into shared processes and technical safeguards, rather than being left to ad hoc solutions.',
        href: '/#product-compliance',
        hrefLabel: 'Explore Compliance',
    },
]

const buttonClass =
    'text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet!'
---

<section
    aria-labelledby="why-knodia-practical-adoption-title"
    class="relative isolate overflow-hidden bg-neutral-white"
>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <img
            alt=""
            class="size-full object-cover object-center"
            decoding="async"
            height={practicalAdoptionBackground.height}
            loading="lazy"
            src={practicalAdoptionBackground.src}
            width={practicalAdoptionBackground.width}
        />
        <div class="absolute inset-0 bg-white/60"></div>
    </div>

    <div
        class="relative mx-auto flex w-full max-w-(--header-shell-max) flex-col items-center gap-10 px-(--header-mobile-padding-x) py-10 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div
            class="flex w-full max-w-289.5 flex-col gap-6 xl:grid xl:grid-cols-[minmax(0,513px)_minmax(0,621px)] xl:items-start xl:gap-6"
        >
            <div class="flex flex-col gap-6 xl:gap-8">
                <h2
                    class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                    id="why-knodia-practical-adoption-title"
                >
                    <span class="block">Ready for practical</span>
                    <span class="block">adoption</span>
                </h2>

                <span
                    aria-hidden="true"
                    class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"
                ></span>
            </div>

            <p
                class="font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                A shared model is only useful if it works with existing systems,
                existing responsibilities and real privacy requirements. Knodia
                is designed to support cross-border interaction without
                centralizing what should stay local.
            </p>
        </div>

        <div class="flex w-full max-w-230.5 flex-col gap-4 xl:gap-8">
            {
                adoptionCards.map((card) => (
                    <article class="rounded-3xl bg-neutral-white px-5 py-6 shadow-(--shadow-what-is-knodia-audience-card) md:px-6 xl:min-h-51.5 xl:px-10 xl:py-10">
                        <div class="flex flex-col gap-5 xl:grid xl:grid-cols-[60px_minmax(0,1fr)_auto] xl:items-center xl:gap-8">
                            <span
                                aria-hidden="true"
                                class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-secondary-soft-quartz text-primary-violet xl:size-15"
                            >
                                <Icon
                                    ariaHidden={true}
                                    class="text-[24px] xl:text-[26px]"
                                    name={card.icon}
                                />
                            </span>

                            <div class="flex min-w-0 flex-col gap-3 xl:gap-4">
                                <h3 class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                                    {card.title}
                                </h3>

                                <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-medium-gray xl:text-button-md xl:leading-6.5">
                                    {card.description}
                                </p>
                            </div>

                            <div class="flex justify-start xl:justify-end">
                                <Button
                                    class:list={[
                                        buttonClass,
                                        'self-start xl:self-center',
                                    ]}
                                    href={card.href}
                                    variant="naked"
                                >
                                    <span class="inline-flex items-center gap-(--button-gap)">
                                        <span class="font-body text-home-domains-link-sm leading-home-domains-link-sm font-medium xl:text-button-md xl:leading-(--leading-button-md)">
                                            {card.hrefLabel}
                                        </span>
                                        <Icon
                                            ariaHidden={true}
                                            name="arrow_forward"
                                        />
                                    </span>
                                </Button>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
