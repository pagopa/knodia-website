---
import Button from '../../Button.astro'
import Icon from '../../Icon'
import federatedNetworkDiagram from '../../../assets/backgrounds/why-knodia-federated-network-diagram.png'

const technologyHref = '/technology'
const buttonClass =
    'text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet!'

const altText =
    'Diagram showing a federated network of connected domains, with Knodia enabling interaction between multiple domains while each one keeps its own systems, data and governance.'
---

<section
    aria-labelledby="why-knodia-federated-network-title"
    class="overflow-hidden"
    style="background: linear-gradient(180deg, var(--color-primary-violet-surface) 0%, var(--color-neutral-white) 60.577%);"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-8 px-(--header-mobile-padding-x) py-10 md:gap-12 md:px-(--home-hero-inline-padding-md) xl:gap-12 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div
            class="flex w-full flex-col gap-8 xl:grid xl:grid-cols-[minmax(0,513px)_minmax(0,621px)] xl:gap-6"
        >
            <div class="flex flex-col gap-6 xl:gap-8">
                <h2
                    class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                    id="why-knodia-federated-network-title"
                >
                    A federated network built across domains
                </h2>

                <span
                    aria-hidden="true"
                    class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"
                ></span>
            </div>

            <div class="flex flex-col gap-6 xl:items-end">
                <p
                    class="font-body text-intro-sm leading-intro-sm font-normal text-neutral-graphite xl:max-w-[621px] xl:text-button-md xl:leading-(--leading-button-md)"
                >
                    <span class="font-medium">Knodia</span>
                    <span>
                        {' '}works as a network of distinct interoperability
                        domains rather than as a single centralized platform.
                        Each domain is governed by a
                    </span>
                    <span class="font-medium"> Knode</span>
                    <span>
                        : the node that manages the organizations within that
                        domain and connects them to other domains in the
                        federation. Together, these connected domains form the
                    </span>
                    <span class="font-medium"> federated architecture</span>
                    <span> behind Knodia.</span>
                </p>

                <Button
                    class:list={[buttonClass, 'self-start xl:self-end']}
                    href={technologyHref}
                    variant="naked"
                >
                    <span class="inline-flex items-center gap-(--button-gap)">
                        <span
                            class="font-body text-button-md leading-(--leading-button-md) font-medium"
                        >
                            Explore Technology
                        </span>
                        <Icon ariaHidden={true} name="arrow_forward" />
                    </span>
                </Button>
            </div>
        </div>

        <div class="w-full overflow-hidden rounded-2xl">
            <p
                class="mb-3 font-body text-[14px] leading-[21px] font-normal text-neutral-medium-gray xl:hidden"
            >
                Swipe horizontally to explore the network diagram.
            </p>

            <div
                class="overflow-x-auto pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            >
                <div
                    class="min-w-[860px] rounded-2xl bg-white shadow-[0_20px_80px_rgba(78,81,230,0.08)] xl:min-w-0"
                >
                    <img
                        alt={altText}
                        class="block h-auto w-full rounded-2xl"
                        decoding="async"
                        height={federatedNetworkDiagram.height}
                        loading="lazy"
                        src={federatedNetworkDiagram.src}
                        width={federatedNetworkDiagram.width}
                    />
                </div>
            </div>
        </div>
    </div>
</section>
