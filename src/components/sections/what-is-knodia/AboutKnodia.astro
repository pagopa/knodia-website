---
import Button from '../../Button.astro'
import aboutKnodiaBackground from '../../../assets/backgrounds/what-is-knodia-about-background.png'

type StatCard = {
    value: string
    labelLines: string[]
}

const platformHref = 'https://developers.italia.it/en/interoperability'
const dtdHref = 'https://innovazione.gov.it/dipartimento/en/what-we-do/'
const pagoPaHref = 'https://www.pagopa.it/en/homepage/'
const sourceDataHref =
    'https://www.dati.gov.it/view-dataset?tags=pdnd&organization=pcm-dipartimento-trasformazione-digitale'

const statCards: StatCard[] = [
    {
        value: '9.300+',
        labelLines: ['PARTICIPATING', 'ENTITIES'],
    },
    {
        value: '14.000+',
        labelLines: ['PUBLISHED', 'E-SERVICES'],
    },
    {
        value: '42.000+',
        labelLines: ['ENTITY TO ENTITY', 'CONNECTIONS'],
    },
    {
        value: '1.25B+',
        labelLines: ['DATA EXCHANGE', 'SESSIONS'],
    },
]

const inlineTextLinkClass =
    'w-auto items-baseline justify-start whitespace-normal text-left align-baseline select-text focus-visible:outline-offset-1 [&>span]:inline [&>span>span]:[font-size:inherit] [&>span>span]:[line-height:inherit] [&>span>span]:[font-weight:inherit] [&>span>span]:underline [&>span>span]:decoration-solid [&>span>span]:underline-offset-2'
const introLinkClass = `${inlineTextLinkClass} text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-primary-violet active:text-deep-violet!`
const sourceLinkClass = `${inlineTextLinkClass} text-neutral-medium-gray! hover:text-neutral-graphite! focus-visible:outline-primary-violet active:text-primary-violet!`
---

<section
    aria-labelledby="what-is-knodia-about-title"
    class="relative isolate overflow-hidden"
>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <img
            alt=""
            class="size-full object-cover object-[68%_center] md:object-[74%_center] xl:object-center"
            decoding="async"
            height={aboutKnodiaBackground.height}
            loading="lazy"
            src={aboutKnodiaBackground.src}
            width={aboutKnodiaBackground.width}
        />
        <div class="absolute inset-0 bg-white/60"></div>
    </div>

    <div
        class="relative mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-12 px-(--header-mobile-padding-x) py-10 md:gap-16 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div
            class="flex w-full flex-col gap-8 xl:grid xl:grid-cols-[minmax(0,513px)_minmax(0,621px)] xl:gap-6"
        >
            <div class="flex flex-col gap-6 xl:gap-8">
                <h2
                    class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                    id="what-is-knodia-about-title"
                >
                    About Knodia
                </h2>

                <span
                    aria-hidden="true"
                    class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"
                ></span>
            </div>

            <div
                class="flex flex-col gap-6 font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                <p>
                    Knodia is the Italian national proposal for a federated
                    cross-border interoperability model, building on the
                    experience of Italy&apos;s
                    <Button
                        class={introLinkClass}
                        href={platformHref}
                        rel="noreferrer"
                        target="_blank"
                        variant="naked"
                    >
                        National Digital Data Platform (PDND)
                    </Button>
                    , a public infrastructure that enables interoperability and secure
                    data exchange among more than 10,000 public and private organisations.
                </p>

                <p>
                    Promoted by Italy&apos;s
                    <Button
                        class={introLinkClass}
                        href={dtdHref}
                        rel="noreferrer"
                        target="_blank"
                        variant="naked"
                    >
                        Department for Digital Transformation
                    </Button>
                    and
                    <Button
                        class={introLinkClass}
                        href={pagoPaHref}
                        rel="noreferrer"
                        target="_blank"
                        variant="naked"
                    >
                        PagoPA S.p.A.
                    </Button>
                    , Knodia brings this proven approach to the European level through
                    a federated interoperability model proposed by Italy to the Interoperable
                    Europe Board, to be tested within the interoperability regulatory
                    sandboxes established under the Interoperable Europe Act (Regulation
                    (EU) 2024/903).
                </p>

                <p>
                    Designed in line with the European Interoperability
                    Framework, GDPR and the principles of the Interoperable
                    Europe Act, Knodia aims to enable secure, consistent
                    cross-border interactions.
                </p>
            </div>
        </div>

        <div class="grid w-full gap-4 md:grid-cols-2 xl:grid-cols-4 xl:gap-6">
            {
                statCards.map((card) => (
                    <article class="flex min-h-41 flex-col rounded-2xl bg-neutral-white px-6 py-6 xl:min-h-45.5 xl:rounded-3xl xl:p-8">
                        <div class="flex flex-col gap-4">
                            <p class="font-heading text-4xl leading-10 font-normal text-primary-violet xl:text-heading-lg xl:leading-heading-lg">
                                {card.value}
                            </p>

                            <p class="font-body text-button-sm leading-(--leading-button-sm) font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                                {card.labelLines.map((line) => (
                                    <span class="block">{line}</span>
                                ))}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>

        <p
            class="w-full text-left font-body text-(length:--text-home-use-case-caption) leading-(--leading-home-use-case-caption) font-medium text-neutral-medium-gray xl:text-right"
        >
            <Button
                class={sourceLinkClass}
                href={sourceDataHref}
                rel="noreferrer"
                target="_blank"
                variant="naked"
            >
                Based on institutional source data
            </Button>
        </p>
    </div>
</section>
