---
type AdditionalFunctionCard = {
    iconSrc: string
    title: string
    description: string
}

const additionalFunctionCards: AdditionalFunctionCard[] = [
    {
        iconSrc: '/icons/core-functions/asynchronous-communications.svg',
        title: 'Asynchronous communications',
        description:
            'Supports interactions that cannot be completed in real time, allowing a service to respond asynchronously when processing takes longer.',
    },
    {
        iconSrc: '/icons/core-functions/signal-distribution.svg',
        title: 'Signal distribution mechanism',
        description:
            'Allows authorised consumers to be notified when relevant data changes, so they can rely on the data they already use until a new signal is received.',
    },
    {
        iconSrc: '/icons/core-functions/e-service-template.svg',
        title: 'E-service template',
        description:
            'Provides a reusable structure for recurring API patterns and common use cases, helping producers publish similar services more consistently and with less repeated effort.',
    },
    {
        iconSrc: '/icons/core-functions/producer-keychain.svg',
        title: 'Producer keychain',
        description:
            'Allows producers to register the cryptographic material used to sign service responses, so the integrity of the transmitted data can be verified when needed.',
    },
] as const
---

<section
    aria-labelledby="core-functions-additional-functions-title"
    class="bg-primary-violet-surface"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-8 px-(--header-mobile-padding-x) py-10 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div
            class="flex w-full flex-col gap-8 xl:grid xl:grid-cols-[minmax(0,513px)_minmax(0,621px)] xl:gap-6"
        >
            <div class="flex flex-col gap-6 xl:gap-8">
                <h2
                    class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                    id="core-functions-additional-functions-title"
                >
                    <span class="block">Additional functions</span>
                    <span class="block">within the model</span>
                </h2>

                <span
                    aria-hidden="true"
                    class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"
                ></span>
            </div>

            <div class="xl:flex xl:justify-end">
                <p
                    class="max-w-(--home-domains-copy-width-mobile) font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:max-w-(--home-domains-copy-width) xl:text-intro-lg xl:leading-intro-lg"
                >
                    Knodia also includes additional capabilities designed to
                    support more advanced operational needs, from longer-running
                    interactions to recurring API structures, signed responses
                    and service updates.
                </p>
            </div>
        </div>

        <div class="grid w-full gap-4 md:grid-cols-2 xl:gap-12">
            {
                additionalFunctionCards.map((card) => (
                    <article class="flex h-full">
                        <div class="flex w-full flex-col gap-6 rounded-3xl bg-neutral-white p-6 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-[264px] xl:gap-8 xl:px-10 xl:py-8">
                            <span
                                aria-hidden="true"
                                class="inline-flex size-12 items-center justify-center rounded-full bg-secondary-soft-quartz xl:size-15"
                            >
                                <img
                                    alt=""
                                    class="size-8"
                                    decoding="async"
                                    loading="lazy"
                                    src={card.iconSrc}
                                />
                            </span>

                            <div class="flex flex-1 flex-col gap-4">
                                <h3 class="font-heading text-[20px] leading-[28px] font-medium text-neutral-graphite xl:text-intro-lg xl:leading-intro-lg xl:font-normal">
                                    {card.title}
                                </h3>

                                <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                                    {card.description}
                                </p>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
