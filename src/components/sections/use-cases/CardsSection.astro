---
import Button from '../../Button.astro'
import { useCases } from '../../../use-cases'

const renderedUseCases = useCases.filter((card) => card.description) //we doesn'want to render the use case shown in the section above the cards section, so we filter out the use case that doesn't have a description
const revealStep = 3
const shouldShowViewMore = renderedUseCases.length > 6 //the section is a grid of 3 columns, so we want to show the "View more" button if there are more than 6 use cases to render
const initialVisibleCount = shouldShowViewMore ? 6 : renderedUseCases.length
---

<section
    aria-labelledby="use-cases-cards-title"
    data-use-cases-cards-root
    class="bg-[linear-gradient(180deg,var(--color-primary-violet-surface)_0%,var(--color-primary-violet-surface)_70%,var(--color-neutral-white)_100%)]"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-12 px-(--header-mobile-padding-x) pt-16 pb-16 md:gap-16 md:px-(--home-hero-inline-padding-md) md:pt-20 md:pb-20 xl:gap-20 xl:px-(--header-inline-padding) xl:pt-32 xl:pb-32"
    >
        <h2 class="sr-only" id="use-cases-cards-title">Use Cases Cards</h2>

        <div
            class="grid gap-6 md:grid-cols-2 xl:grid-cols-3"
            id="use-cases-cards-grid"
        >
            {
                renderedUseCases.map((card, index) => (
                    <article
                        class={`flex min-h-66.75 flex-col justify-between rounded-3xl bg-neutral-white p-8 shadow-[0px_4px_8px_rgba(14,15,19,0.1)] ${index >= initialVisibleCount ? 'hidden' : ''}`}
                        data-use-case-card
                    >
                        <div class="flex flex-col gap-4">
                            <div class="flex flex-wrap gap-2 xl:gap-4">
                                {card.tags.map((tag) => (
                                    <span class="inline-flex h-(--home-use-case-tag-height-mobile) w-fit items-center justify-center rounded-full border border-primary-violet px-(--home-use-case-tag-padding-x-mobile) font-caption text-home-use-case-tag-sm leading-home-use-case-tag-sm font-semibold text-primary-violet uppercase xl:h-(--home-use-case-tag-height) xl:px-(--home-use-case-tag-padding-x) xl:text-(length:--text-home-use-case-tag) xl:leading-(--leading-home-use-case-tag)">
                                        {tag}
                                    </span>
                                ))}
                            </div>

                            <h3 class="font-heading text-heading-md leading-heading-md font-normal text-neutral-graphite">
                                {card.title}
                            </h3>

                            <p class="font-body text-button-md leading-(--leading-button-md) font-normal text-neutral-medium-gray">
                                {card.description}
                            </p>
                        </div>

                        <Button
                            aria-label={`Read more about ${card.title}`}
                            class="mt-8 self-start text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet! xl:[&>span]:gap-(--button-gap)"
                            href={card.href}
                            icon="arrow_forward"
                            size="small"
                            variant="naked"
                        >
                            <span class="text-home-domains-link-sm leading-home-domains-link-sm font-medium xl:text-button-md xl:leading-(--leading-button-md)">
                                Read more
                            </span>
                        </Button>
                    </article>
                ))
            }
        </div>

        {
            shouldShowViewMore && (
                <div
                    class="flex justify-center"
                    data-initial-visible={initialVisibleCount}
                    data-reveal-step={revealStep}
                    id="use-cases-view-more-wrapper"
                >
                    <Button
                        class="text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet! xl:[&>span]:gap-(--button-gap)"
                        href="#use-cases-view-more-wrapper"
                        icon="arrow_downward"
                        size="small"
                        variant="naked"
                        aria-label="View more use cases"
                    >
                        <span class="text-home-domains-link-sm leading-home-domains-link-sm font-medium xl:text-button-md xl:leading-(--leading-button-md)">
                            View more
                        </span>
                    </Button>
                </div>
            )
        }
    </div>
</section>

<script>
    import './cards-section-view-more'
</script>
