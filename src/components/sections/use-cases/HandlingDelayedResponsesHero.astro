---
import Button from '../../Button.astro'
import knodiaMark from '../../../assets/icons/knodia-mark.svg'
---

<section
    aria-labelledby="handling-delayed-responses-hero-title"
    class="bg-primary-violet-surface"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-12 px-(--header-mobile-padding-x) pt-34 pb-14 md:px-(--home-hero-inline-padding-md) md:pt-40 md:pb-20 xl:gap-(--home-use-case-column-gap) xl:px-(--header-inline-padding) xl:pt-40.75 xl:pb-27"
    >
        <Button
            class="self-start text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet!"
            href="/use-cases"
            icon="arrow_back"
            iconPosition="left"
            size="small"
            variant="naked"
        >
            <span
                class="text-button-md leading-(--leading-button-md) font-medium"
                >Back</span
            >
        </Button>

        <div
            class="flex flex-col gap-10 xl:grid xl:grid-cols-[minmax(0,570px)_minmax(0,507px)] xl:items-center xl:justify-between"
        >
            <div class="flex flex-col gap-6 xl:gap-(--home-use-case-copy-gap)">
                <p
                    class="font-heading text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray md:text-intro-lg md:leading-intro-lg"
                >
                    Asynchronous exchange
                </p>

                <h1
                    class="font-heading text-hero-sm leading-hero-sm font-semibold tracking-hero-sm text-neutral-graphite md:text-home-cta-title md:leading-17 md:tracking-[-0.84px] xl:text-hero-lg xl:leading-hero-lg xl:tracking-hero-lg"
                    id="handling-delayed-responses-hero-title"
                >
                    Handling requests with delayed responses
                </h1>

                <p
                    class="max-w-full font-heading text-intro-sm leading-intro-sm font-normal text-neutral-graphite md:max-w-155 md:text-home-use-case-title-sm md:leading-[30px] xl:max-w-(--home-use-case-copy-width) xl:text-intro-lg xl:leading-intro-lg"
                >
                    Knodia supports situations where requests require extended
                    processing time and responses need to be handled
                    asynchronously.
                </p>
            </div>

            <div
                class="relative h-(--home-use-case-image-height-mobile) w-full overflow-hidden rounded-(--home-use-case-image-radius-mobile) bg-primary-violet-surface md:h-80 xl:h-(--home-use-case-image-height) xl:w-(--home-use-case-image-width) xl:rounded-(--home-use-case-image-radius)"
            >
                <svg
                    aria-hidden="true"
                    class="absolute inset-0 h-full w-full"
                    fill="none"
                    viewBox="0 0 507 320"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M170 65C238 65 246 132 246 148"
                        stroke="#A1A5FF"
                        stroke-width="1.5"
                    />
                    <path
                        d="M182 75C182 198 275 250 406 250"
                        stroke="#A1A5FF"
                        stroke-dasharray="6 7"
                        stroke-width="1.5"
                    />
                    <path
                        d="M246 148C312 148 312 205 346 205"
                        stroke="#A1A5FF"
                        stroke-width="1.5"
                    />

                    <circle
                        cx="246"
                        cy="148"
                        r="21"
                        stroke="#4E51E6"
                        stroke-dasharray="6 6"
                        stroke-width="3"
                    />
                    <circle
                        cx="346"
                        cy="205"
                        r="21"
                        stroke="#4E51E6"
                        stroke-dasharray="6 6"
                        stroke-width="3"
                    />
                    <circle cx="435" cy="245" r="21" stroke="#4E51E6" stroke-width="3" />
                </svg>

                <div
                    class="absolute top-8 left-24 flex size-21 items-center justify-center rounded-2xl bg-primary-violet shadow-[0_8px_18px_rgba(78,81,230,0.35)]"
                >
                    <img
                        alt=""
                        class="h-12 w-13.5"
                        decoding="async"
                        loading="eager"
                        src={knodiaMark.src}
                    />
                </div>
            </div>
        </div>
    </div>
</section>
