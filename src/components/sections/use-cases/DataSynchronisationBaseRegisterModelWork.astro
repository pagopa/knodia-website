---
type ModelWorkCard = {
    title: string
    description: string
}

const modelWorkCards: ModelWorkCard[] = [
    {
        title: 'Access only to relevant data',
        description:
            'Participating organizations access only the data that are relevant to their role and use case.',
    },
    {
        title: 'A shared interaction model',
        description:
            'Data retrieval and update handling need to follow a common cross-border model.',
    },
    {
        title: 'A clear source of truth',
        description:
            'The authoritative source remains the reference point for the data in use locally.',
    },
    {
        title: 'Common mechanisms for updates',
        description:
            'Organizations can rely on a single mechanism to receive signals when relevant data is updated.',
    },
]
---

<section
    aria-labelledby="data-synchronisation-base-register-model-work-title"
    class="bg-neutral-white"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-12 px-(--header-mobile-padding-x) py-16 md:px-(--home-hero-inline-padding-md) md:py-20 xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div
            class="flex flex-col gap-6 xl:grid xl:grid-cols-[minmax(0,513px)_minmax(0,621px)] xl:items-start xl:justify-between"
        >
            <div class="flex flex-col gap-8">
                <h2
                    class="font-heading text-home-support-title-sm leading-home-support-title-sm font-normal text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg"
                    id="data-synchronisation-base-register-model-work-title"
                >
                    <span class="block">What makes this</span>
                    <span class="block">model work</span>
                </h2>

                <span
                    aria-hidden="true"
                    class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"
                ></span>
            </div>

            <p
                class="font-heading text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                Consistent data synchronization across domains depends on a few
                shared conditions around access, updates and source
                responsibility.
            </p>
        </div>

        <div
            class="grid w-full max-w-289.5 gap-6 md:grid-cols-2 xl:grid-cols-4"
        >
            {
                modelWorkCards.map((card) => (
                    <article class="flex h-full flex-col gap-4 rounded-3xl bg-primary-violet-surface p-6 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-66.75 xl:gap-8 xl:p-8">
                        <h3 class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                            {card.title}
                        </h3>

                        <p class="font-body text-button-sm leading-(--leading-button-sm) font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                            {card.description}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
