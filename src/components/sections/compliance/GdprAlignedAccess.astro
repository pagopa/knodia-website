---
import Button from '../../Button.astro'
import Icon from '../../Icon'

type GdprAccessStep = {
    id: 'controlled-access' | 'enforced-requirements' | 'full-traceability'
    label: string
    description: string
}

const exploreSecurityHref = '/security'

const gdprAccessSteps: GdprAccessStep[] = [
    {
        id: 'controlled-access',
        label: 'Controlled access',
        description:
            'Knodia allows access conditions to be defined before data is exchanged. Producers can set the requirements for access, and consumers can declare the lawfulness of processing, including the basis under Article 6 GDPR where personal data is involved.',
    },
    {
        id: 'enforced-requirements',
        label: 'Enforced requirements',
        description:
            'The framework connects privacy requirements to the technical flow of the interaction. Token issuance, keychains and proof mechanisms help ensure that the conditions defined for access can also be reflected in implementation.',
    },
    {
        id: 'full-traceability',
        label: 'Full traceability',
        description:
            'Requests, approvals, declared purposes and access tokens remain part of the same governed sequence. This makes access easier to trace, review and document.',
    },
]

const defaultStepId = gdprAccessSteps[0].id
---

<section
    aria-labelledby="compliance-gdpr-title"
    class="bg-primary-violet-surface"
    data-compliance-gdpr
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-8 px-(--header-mobile-padding-x) py-10 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div class="flex w-full flex-col items-center gap-6 xl:gap-6">
            <h2
                class="max-w-171 text-center font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                id="compliance-gdpr-title"
            >
                Designed for GDPR-aligned access
            </h2>

            <span
                aria-hidden="true"
                class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"></span>

            <p
                class="max-w-171 text-center font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                Knodia gives organizations a structured way to govern access to
                data across domains, so privacy requirements can be handled
                within the interaction model.
            </p>
        </div>

        <div
            class="flex w-full flex-col gap-6 xl:flex-row xl:items-start xl:gap-14"
        >
            <div
                aria-label="GDPR-aligned access topics"
                class="flex w-full max-w-142.75 flex-col gap-4 xl:gap-6"
                role="tablist"
                aria-orientation="vertical"
            >
                {
                    gdprAccessSteps.map((step) => (
                        <button
                            aria-controls={`compliance-gdpr-panel-${step.id}`}
                            aria-selected={
                                step.id === defaultStepId ? 'true' : 'false'
                            }
                            class="w-full rounded-2xl bg-neutral-white px-6 py-6 text-left font-heading text-intro-sm leading-intro-sm font-normal text-neutral-graphite shadow-(--shadow-home-guidance-pill) transition-colors duration-150 ease-out hover:text-deep-violet focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-violet focus-visible:outline-solid aria-selected:bg-secondary-soft-quartz xl:text-intro-lg xl:leading-intro-lg"
                            data-compliance-gdpr-trigger={step.id}
                            id={`compliance-gdpr-trigger-${step.id}`}
                            role="tab"
                            tabindex={step.id === defaultStepId ? '0' : '-1'}
                            type="button"
                        >
                            {step.label}
                        </button>
                    ))
                }
            </div>

            <div class="w-full xl:max-w-132.75">
                {
                    gdprAccessSteps.map((step) => (
                        <section
                            aria-labelledby={`compliance-gdpr-trigger-${step.id}`}
                            class="relative overflow-hidden rounded-2xl bg-linear-to-br from-neutral-white/95 via-neutral-white/80 to-primary-light-violet/60 px-6 py-8 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-69 xl:px-8 xl:py-10"
                            data-compliance-gdpr-panel={step.id}
                            hidden={step.id !== defaultStepId}
                            id={`compliance-gdpr-panel-${step.id}`}
                            role="tabpanel"
                            tabindex={step.id === defaultStepId ? '0' : '-1'}
                        >
                            <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-graphite xl:text-button-md xl:leading-(--leading-button-md)">
                                {step.description}
                            </p>
                        </section>
                    ))
                }
            </div>
        </div>

        <section
            aria-labelledby="compliance-governance-banner-title"
            class="rounded-3xl bg-primary-light-violet px-6 py-8 xl:px-12 xl:py-12"
        >
            <div
                class="flex w-full flex-col gap-6 xl:flex-row xl:items-center xl:gap-10"
            >
                <span
                    aria-hidden="true"
                    class="inline-flex size-16 items-center justify-center text-deep-violet xl:size-23"
                >
                    <Icon
                        ariaHidden={true}
                        class="text-heading-lg xl:text-[58px]"
                        name="share"
                    />
                </span>

                <div class="flex flex-1 flex-col gap-4">
                    <h3
                        class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal"
                        id="compliance-governance-banner-title"
                    >
                        Knodia governs the interaction, not the data
                    </h3>

                    <p
                        class="font-body text-button-sm leading-(--leading-button-sm) font-normal text-neutral-graphite xl:text-button-md xl:leading-(--leading-button-md)"
                    >
                        The framework defines the rules for data exchange. The
                        data itself never passes through Knodia: it stays within
                        the organizations involved, visible only to the parties
                        with explicit access.
                    </p>

                    <Button
                        class="self-start text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet!"
                        href={exploreSecurityHref}
                        icon="arrow_forward"
                        variant="naked"
                    >
                        <span
                            class="font-body text-button-md leading-(--leading-button-md) font-medium"
                        >
                            Explore Security
                        </span>
                    </Button>
                </div>
            </div>
        </section>
    </div>
</section>

<script>
    import './compliance-gdpr-tabs'
</script>
