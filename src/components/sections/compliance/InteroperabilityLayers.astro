---
type InteroperabilityLayerCard = {
    id: string
    title: string
    description: string
}

const interoperabilityLayerCards: InteroperabilityLayerCard[] = [
    {
        id: 'legal',
        title: 'Legal interoperability',
        description:
            'Knodia provides a shared access model that handles access conditions, declared purposes and additional national requirements within the same interaction flow.',
    },
    {
        id: 'organizational',
        title: 'Organizational interoperability',
        description:
            'Knodia defines a shared interaction model for requesting, approving and managing access across domains, with clear roles and responsibilities for the organizations involved.',
    },
    {
        id: 'semantic',
        title: 'Semantic interoperability',
        description:
            'Knodia supports common semantic elements such as attributes, categories and other definitions used across the federation.',
    },
    {
        id: 'technical',
        title: 'Technical interoperability',
        description:
            'Knodia provides a common technical model for secure exchange, including shared APIs, token issuance, keychains and proof mechanisms.',
    },
]
---

<section
    aria-labelledby="compliance-layers-title"
    class="bg-primary-violet-surface"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-10 px-(--header-mobile-padding-x) py-10 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div
            class="grid w-full gap-6 xl:grid-cols-[minmax(0,513px)_minmax(0,621px)] xl:gap-6"
        >
            <div class="flex flex-col gap-6 xl:gap-8">
                <h2
                    class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                    id="compliance-layers-title"
                >
                    Knodia across all four interoperability layers
                </h2>

                <span
                    aria-hidden="true"
                    class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"
                ></span>
            </div>

            <p
                class="font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                The European Interoperability Framework (EIF) defines four
                layers for cross-domain interaction: legal, organizational,
                semantic and technical. Knodia is built to handle them within
                one shared model.
            </p>
        </div>

        <div
            class="grid w-full max-w-289.5 gap-6 md:grid-cols-2 xl:grid-cols-4"
        >
            {
                interoperabilityLayerCards.map((card) => (
                    <article class="flex h-full flex-col gap-4 rounded-3xl bg-neutral-white p-6 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-66.75 xl:gap-8 xl:p-8">
                        <h3 class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                            {card.title}
                        </h3>

                        <p class="font-body text-button-sm leading-(--leading-button-sm) font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                            {card.description}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
