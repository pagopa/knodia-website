---
import Button from '../../Button.astro'
import Icon from '../../Icon'

type DifferenceCard = {
    highlight: string
    label: string
    description: string
}

type DifferenceBenefit = {
    label: string
}

const cards: DifferenceCard[] = [
    {
        highlight: 'Legal',
        label: 'Interoperability',
        description:
            'GDPR compliant, extensible to national regulations per Knode.',
    },
    {
        highlight: 'Semantic',
        label: 'Interoperability',
        description:
            'Federated Attributes and Categories to profile parties and define API access.',
    },
    {
        highlight: 'Organisational',
        label: 'Interoperability',
        description:
            'Clear roles and agreements based on Federated Attributes.',
    },
    {
        highlight: 'Technical',
        label: 'Interoperability',
        description:
            'Open standards-based protocol for access token issuance across Knodes.',
    },
]

const benefits: DifferenceBenefit[] = [
    {
        label: 'Scalable by design',
    },
    {
        label: 'Less duplication',
    },
    {
        label: 'Trusted access',
    },
    {
        label: 'Local autonomy',
    },
]

const ctaHref = '/why-knodia'
---

<section aria-labelledby="home-difference-title" class="bg-neutral-white">
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col items-center gap-(--home-difference-root-gap-mobile) px-(--header-mobile-padding-x) pt-(--home-difference-padding-top-mobile) pb-(--home-difference-padding-bottom-mobile) md:px-(--home-hero-inline-padding-md) xl:gap-(--home-difference-root-gap) xl:px-(--header-inline-padding) xl:pt-(--home-difference-padding-top) xl:pb-(--home-difference-padding-bottom)"
    >
        <div
            class="flex max-w-(--home-difference-header-max) flex-col items-center gap-(--home-difference-header-gap-mobile) text-center xl:gap-(--home-difference-header-gap)"
        >
            <h2
                class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                id="home-difference-title"
            >
                What makes Knodia different
            </h2>
            <div
                aria-hidden="true"
                class="h-(--home-guidance-separator-height-mobile) w-(--home-guidance-separator-width-mobile) rounded-full bg-primary-violet xl:h-(--home-guidance-separator-height) xl:w-(--home-guidance-separator-width)"
            >
            </div>
            <p
                class="text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                Knodia is the only framework designed to address all four
                interoperability layers
            </p>
        </div>

        <div
            class="grid w-full gap-(--home-difference-card-gap-mobile) xl:grid-cols-4 xl:gap-(--home-difference-card-gap)"
        >
            {
                cards.map((card) => (
                    <article class="flex min-h-(--home-difference-card-height-mobile) flex-col gap-(--home-difference-card-inner-gap-mobile) rounded-(--home-difference-card-radius-mobile) bg-primary-violet-surface px-(--home-difference-card-padding-x-mobile) py-(--home-difference-card-padding-y-mobile) xl:min-h-(--home-difference-card-height) xl:gap-(--home-difference-card-inner-gap) xl:rounded-(--home-difference-card-radius) xl:p-(--home-difference-card-padding)">
                        <h3 class="font-heading text-(length:--text-home-difference-card-title-sm) leading-(--leading-home-difference-card-title-sm) font-normal text-neutral-graphite xl:text-intro-lg xl:leading-intro-lg">
                            <span class="text-primary-violet">
                                {card.highlight}
                            </span>
                            <span> {card.label}</span>
                        </h3>
                        <p class="text-(length:--text-home-difference-card-body-sm) leading-home-difference-card-body-sm font-medium text-neutral-medium-gray xl:text-(length:--text-home-difference-card-body-lg) xl:leading-(--leading-home-difference-card-body-lg)">
                            {card.description}
                        </p>
                    </article>
                ))
            }
        </div>

        <div
            class="flex w-full flex-col items-center gap-(--home-difference-benefits-gap-mobile) xl:gap-(--home-difference-benefits-gap)"
        >
            <div
                aria-hidden="true"
                class="h-(--home-guidance-separator-height-mobile) w-(--home-guidance-separator-width-mobile) rounded-full bg-primary-violet xl:h-(--home-guidance-separator-height) xl:w-(--home-guidance-separator-width)"
            >
            </div>
            <p
                class="text-(length:--text-home-difference-overline-sm) leading-home-difference-overline-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                How Knodia goes beyond
            </p>

            <div
                class="w-full rounded-(--home-difference-benefits-box-radius-mobile) border-(length:--border-home-difference-highlight) border-solid border-secondary-soft-quartz px-(--home-difference-benefits-box-padding-x-mobile) py-(--home-difference-benefits-box-padding-y-mobile) xl:rounded-(--home-difference-benefits-box-radius) xl:px-(--home-difference-benefits-box-padding-x) xl:py-(--home-difference-benefits-box-padding-y)"
            >
                <ul
                    class="grid grid-cols-2 gap-x-(--home-difference-benefits-gap-x-mobile) gap-y-(--home-difference-benefits-gap-y-mobile) xl:grid-cols-4 xl:gap-x-(--home-difference-benefits-gap-x) xl:gap-y-0"
                >
                    {
                        benefits.map((benefit) => (
                            <li class="flex flex-col items-center gap-(--home-difference-benefit-item-gap-mobile) text-center xl:flex-row xl:items-center xl:gap-(--home-difference-benefit-item-gap) xl:text-left">
                                <span
                                    aria-hidden="true"
                                    class="flex size-(--home-difference-check-circle-size-mobile) shrink-0 items-center justify-center rounded-full bg-secondary-soft-quartz xl:size-(--home-difference-check-circle-size)"
                                >
                                    <Icon
                                        ariaHidden={true}
                                        class="text-(length:--text-home-difference-check-icon-sm) text-primary-violet xl:text-(length:--text-home-difference-check-icon-lg)"
                                        name="check"
                                    />
                                </span>
                                <span class="text-home-difference-benefit-sm leading-home-difference-benefit-sm font-normal text-neutral-graphite xl:text-button-md xl:leading-(--leading-button-md)">
                                    {benefit.label}
                                </span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <Button
                class="text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet! xl:[&>span]:gap-(--button-gap)"
                href={ctaHref}
                icon="arrow_forward"
                size="small"
                variant="naked"
            >
                <span
                    class="text-home-domains-link-sm leading-home-domains-link-sm font-medium xl:text-button-md xl:leading-(--leading-button-md)"
                >
                    Why choose Knodia
                </span>
            </Button>
        </div>
    </div>
</section>
