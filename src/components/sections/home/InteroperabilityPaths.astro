---
import Button from '../../Button.astro'
import Icon from '../../Icon'

type GuidanceLink = {
    href: string
    label: string
}

type GuidancePanel = {
    id: 'decision-makers' | 'tech-teams' | 'privacy-legal'
    label: string
    title: string
    description: string
    descriptionDesktopLeadingClass: string
    links: GuidanceLink[]
}

const guidancePanels: GuidancePanel[] = [
    {
        id: 'decision-makers',
        label: 'Decision makers',
        title: 'The case for Knodia',
        description:
            'See how a shared cross-border framework can make interoperability easier to support and scale.',
        descriptionDesktopLeadingClass:
            'xl:leading-(--home-guidance-card-body-leading-lg-compact)',
        links: [
            {
                href: '/what-is-knodia',
                label: 'What is Knodia',
            },
            {
                href: '/why-knodia',
                label: 'Why Knodia',
            },
        ],
    },
    {
        id: 'tech-teams',
        label: 'Tech teams',
        title: 'Inside the framework',
        description:
            'Explore the core components, the technical model and the logic behind secure cross-border interactions.',
        descriptionDesktopLeadingClass:
            'xl:leading-(--home-guidance-card-body-leading-lg)',
        links: [
            {
                href: '/core-components',
                label: 'Core functions',
            },
            {
                href: '/#product-technology',
                label: 'Technology',
            },
            {
                href: '/#product-security',
                label: 'Security',
            },
        ],
    },
    {
        id: 'privacy-legal',
        label: 'Privacy and legal teams',
        title: 'Rules you can work with',
        description:
            'Understand how Knodia distributes responsibilities and structures shared governance.',
        descriptionDesktopLeadingClass:
            'xl:leading-(--home-guidance-card-body-leading-lg)',
        links: [
            {
                href: '/#product-compliance',
                label: 'Compliance',
            },
            {
                href: '/#product-governance',
                label: 'Governance',
            },
        ],
    },
]

const defaultPanelId = guidancePanels[0].id

function joinClasses(...classes: Array<string | undefined>) {
    return classes.filter(Boolean).join(' ')
}
---

<section
    aria-labelledby="home-guidance-title"
    class="bg-linear-to-br from-neutral-white via-primary-violet-surface to-primary-light-violet"
    data-home-guidance
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col items-center gap-(--home-guidance-root-gap-mobile) px-(--header-mobile-padding-x) pt-(--home-guidance-padding-top-mobile) pb-(--home-guidance-padding-bottom-mobile) md:px-(--home-hero-inline-padding-md) xl:gap-(--home-guidance-root-gap) xl:px-(--header-inline-padding) xl:pt-(--home-guidance-padding-top) xl:pb-(--home-guidance-padding-bottom)"
    >
        <div
            class="flex max-w-(--home-guidance-header-max) flex-col items-center gap-(--home-guidance-header-gap-mobile) text-center xl:gap-(--home-guidance-header-gap)"
        >
            <h2
                class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                id="home-guidance-title"
            >
                Designed for the people behind interoperability
            </h2>
            <div
                aria-hidden="true"
                class="h-(--home-guidance-separator-height-mobile) w-(--home-guidance-separator-width-mobile) rounded-full bg-primary-violet xl:h-(--home-guidance-separator-height) xl:w-(--home-guidance-separator-width)"
            >
            </div>
            <p
                class="text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                Cross-border interoperability involves different roles,
                responsibilities and perspectives. Start from the path most
                relevant to you.
            </p>
        </div>

        <div
            aria-describedby="home-guidance-instructions"
            aria-label="Audience paths"
            class="flex w-full max-w-(--home-guidance-card-max) flex-wrap items-start justify-center gap-(--home-guidance-tabs-gap-mobile) xl:gap-(--home-guidance-tabs-gap)"
            role="group"
        >
            <p class="sr-only" id="home-guidance-instructions">
                Choose an audience path to reveal the related links. You can
                move between the audience buttons with Tab or the arrow keys.
            </p>

            {
                guidancePanels.map((panel) => (
                    <Fragment>
                        <button
                            aria-controls={`home-guidance-panel-${panel.id}`}
                            aria-expanded={
                                panel.id === defaultPanelId ? 'true' : 'false'
                            }
                            class="order-1 inline-flex h-(--home-guidance-pill-height-mobile) items-center justify-center rounded-full bg-neutral-white px-(--home-guidance-pill-padding-x-mobile) text-(length:--home-guidance-pill-text-sm) leading-(--home-guidance-pill-leading-sm) font-medium whitespace-nowrap text-neutral-graphite shadow-(--shadow-home-guidance-pill) transition-colors duration-150 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-violet focus-visible:outline-solid aria-expanded:bg-secondary-soft-quartz xl:h-(--home-guidance-pill-height) xl:px-(--home-guidance-pill-padding-x) xl:text-button-md xl:leading-(--leading-button-md)"
                            data-guidance-trigger={panel.id}
                            id={`home-guidance-trigger-${panel.id}`}
                            type="button"
                        >
                            {panel.label}
                        </button>

                        <section
                            aria-labelledby={`home-guidance-trigger-${panel.id}`}
                            class="order-2 mt-[calc(var(--home-guidance-stack-gap-mobile)-var(--home-guidance-tabs-gap-mobile))] w-full basis-full rounded-(--home-guidance-card-radius-mobile) bg-neutral-white p-(--home-guidance-card-padding-mobile) shadow-(--shadow-home-guidance-card-mobile) xl:mt-[calc(var(--home-guidance-stack-gap)-var(--home-guidance-tabs-gap))] xl:rounded-(--home-guidance-card-radius) xl:p-(--home-guidance-card-padding) xl:shadow-(--shadow-home-guidance-card)"
                            data-guidance-panel={panel.id}
                            hidden={panel.id !== defaultPanelId}
                            id={`home-guidance-panel-${panel.id}`}
                            role="region"
                        >
                            <div class="flex flex-col gap-(--home-guidance-card-gap-mobile) xl:gap-(--home-guidance-card-gap)">
                                <div class="flex flex-col gap-(--home-guidance-card-copy-gap-mobile) text-neutral-graphite xl:gap-(--home-guidance-card-copy-gap)">
                                    <h3 class="font-heading text-(length:--home-guidance-card-title-sm) leading-(--home-guidance-card-leading-sm) font-medium xl:text-heading-md xl:leading-heading-md xl:font-normal">
                                        {panel.title}
                                    </h3>
                                    <p
                                        class={joinClasses(
                                            'text-(length:--home-guidance-card-body-sm) leading-(--home-guidance-card-body-leading-sm) font-normal xl:text-button-md',
                                            panel.descriptionDesktopLeadingClass
                                        )}
                                    >
                                        {panel.description}
                                    </p>
                                </div>

                                <div class="flex flex-col gap-(--home-guidance-links-gap-mobile) xl:flex-row xl:flex-wrap xl:gap-(--home-guidance-links-gap)">
                                    {panel.links.map((link) => (
                                        <Button
                                            class="w-full justify-start text-left text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet! xl:min-w-0 xl:flex-1 [&>span]:w-full [&>span]:justify-start"
                                            href={link.href}
                                            icon="arrow_forward"
                                            size="small"
                                            variant="naked"
                                        >
                                            <span class="flex items-center gap-(--home-guidance-link-gap-mobile) xl:gap-(--home-guidance-link-gap)">
                                                <span
                                                    aria-hidden="true"
                                                    class="flex size-(--home-guidance-link-icon-box-size-mobile) shrink-0 items-center justify-center rounded-(--home-guidance-link-icon-box-radius-mobile) bg-secondary-soft-quartz xl:size-(--home-guidance-link-icon-box-size) xl:rounded-(--home-guidance-link-icon-box-radius)"
                                                >
                                                    <Icon
                                                        ariaHidden={true}
                                                        class="text-primary-violet"
                                                        name="source"
                                                    />
                                                </span>
                                                <span class="text-home-domains-link-sm leading-home-domains-link-sm font-medium xl:text-button-md xl:leading-(--leading-button-md)">
                                                    {link.label}
                                                </span>
                                            </span>
                                        </Button>
                                    ))}
                                </div>
                            </div>
                        </section>
                    </Fragment>
                ))
            }
        </div>
    </div>
</section>

<script>
    import './interoperability-paths'
</script>
