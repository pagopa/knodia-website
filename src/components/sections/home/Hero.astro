---
import heroBackground from '../../../assets/backgrounds/home-hero-background-desktop.png'
import Icon from '../../Icon'

const exploreHref = '/what-is-knodia'
---

<section
    aria-labelledby="home-hero-title"
    class="relative isolate overflow-hidden bg-hero-base text-neutral-white"
>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <img
            alt=""
            class="size-full object-cover object-center"
            decoding="async"
            fetchpriority="high"
            height={heroBackground.height}
            loading="eager"
            src={heroBackground.src}
            width={heroBackground.width}
        />
    </div>
    <div
        class="relative mx-auto flex min-h-170 max-w-(--header-shell-max) items-start px-(--header-mobile-padding-x) pt-(--home-hero-padding-top-mobile) pb-(--home-hero-padding-bottom-mobile) md:min-h-180 md:px-(--home-hero-inline-padding-md) md:pt-(--home-hero-padding-top-md) md:pb-(--home-hero-padding-bottom-md) xl:min-h-200 xl:px-(--header-inline-padding) xl:pt-(--home-hero-padding-top) xl:pb-(--home-hero-padding-bottom)"
    >
        <div
            class="flex max-w-(--home-hero-content-width-mobile) flex-col gap-(--home-hero-content-gap-mobile) xl:max-w-(--home-hero-content-width) xl:gap-(--home-hero-content-gap)"
        >
            <h1
                class="font-heading text-hero-sm leading-hero-sm font-semibold tracking-hero-sm text-neutral-white xl:text-hero-lg xl:leading-hero-lg xl:tracking-hero-lg"
                id="home-hero-title"
            >
                <span class="block">Building the</span>
                <span class="block">
                    <span class="text-secondary-muted-amber">
                        next generation
                    </span>
                    <span> of interoperability</span>
                </span>
            </h1>
            <p
                class="max-w-(--home-hero-copy-width-mobile) text-intro-sm leading-intro-sm font-normal text-neutral-white xl:max-w-(--home-hero-copy-width) xl:text-intro-lg xl:leading-intro-lg"
            >
                Knodia is Italy’s national proposal, built on a federated model,
                for trusted cross-border data exchange between public
                administrations and businesses.
            </p>
            <a
                class="inline-flex w-fit items-center gap-(--button-gap) text-button-md leading-(--leading-button-md) font-medium text-secondary-muted-amber transition-colors duration-150 ease-out hover:text-secondary-soft-quartz focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-white active:text-secondary-muted-amber"
                href={exploreHref}
            >
                <span>Explore Knodia</span>
                <Icon ariaHidden={true} name="arrow_forward" />
            </a>
        </div>
    </div>
</section>
