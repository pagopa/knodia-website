---
type SecurityPrinciple = {
    title: string
    description: string
}

const securityPrinciples: SecurityPrinciple[] = [
    {
        title: 'Privacy-first',
        description:
            'Knodia protects sensitive interactions while limiting unnecessary exposure of personal data across domains.',
    },
    {
        title: 'Data minimization',
        description:
            'Knodia meets GDPR privacy requirements and is built to exchange only the information needed to enable a specific interaction.',
    },
    {
        title: 'Non-repudiation',
        description:
            'Service responses can be verified so their origin cannot be denied later.',
    },
    {
        title: 'Accountability and traceability',
        description:
            'Knodes provide the tools and evidence needed to make cross-border exchanges easier to track and verify.',
    },
]
---

<section
    aria-labelledby="security-principles-title"
    class="bg-primary-violet-surface"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col items-center gap-8 px-(--header-mobile-padding-x) py-10 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div class="flex max-w-171 flex-col items-center gap-6 text-center">
            <h2
                class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                id="security-principles-title"
            >
                The principles behind the security model
            </h2>

            <span
                aria-hidden="true"
                class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"></span>

            <p
                class="font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                This is a set of principles we apply to make cross-border
                exchanges more trustworthy, controlled and verifiable over time.
            </p>
        </div>

        <div class="grid w-full gap-4 md:grid-cols-2 xl:grid-cols-4 xl:gap-6">
            {
                securityPrinciples.map((principle) => (
                    <article class="h-full rounded-3xl bg-neutral-white p-6 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-66.75">
                        <div class="flex h-full flex-col gap-4">
                            <h3 class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                                {principle.title}
                            </h3>

                            <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                                {principle.description}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
