---
import Icon from '../../Icon'

type SecurityLevelCard = {
    title: string
    description: string
}

const securityLevelCards: SecurityLevelCard[] = [
    {
        title: 'Product-level',
        description:
            'Security is built into the platform itself, through strong engineering standards, established security patterns and standard RFCs.',
    },
    {
        title: 'Interaction-level',
        description:
            'Security is applied to exchanges, both to protect interactions and to ensure that access is appropriate to the use case.',
    },
    {
        title: 'Framework-level',
        description:
            'Security is encouraged across the ecosystem through the standards and good practices defined by the Knodia Consortium.',
    },
]
---

<section
    aria-labelledby="security-framework-levels-title"
    class="bg-primary-violet-surface"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-8 px-(--header-mobile-padding-x) pt-10 pb-10 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:pt-32 xl:pb-0"
    >
        <div
            class="flex w-full max-w-171 flex-col items-center gap-6 self-center text-center"
        >
            <h2
                class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                id="security-framework-levels-title"
            >
                Security across the framework
            </h2>

            <span
                aria-hidden="true"
                class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"></span>

            <p
                class="font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                Knodia allows security measures to be applied at different
                levels, depending on the interaction and the protection
                required.
            </p>
        </div>

        <div class="grid w-full gap-4 md:grid-cols-2 xl:grid-cols-3 xl:gap-6">
            {
                securityLevelCards.map((card) => (
                    <article class="h-full rounded-3xl bg-neutral-white p-6 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-62 xl:p-8">
                        <div class="flex h-full flex-col gap-4 xl:gap-6">
                            <span
                                aria-hidden="true"
                                class="inline-flex size-8 items-center justify-center rounded-full bg-secondary-soft-quartz text-primary-violet xl:size-10"
                            >
                                <Icon
                                    ariaHidden={true}
                                    class="text-5 xl:text-6"
                                    name="security"
                                />
                            </span>

                            <h3 class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                                {card.title}
                            </h3>

                            <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                                {card.description}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>

        <article
            class="mb-10 flex w-full items-start gap-6 rounded-3xl bg-primary-light-violet px-6 py-8 xl:mb-32 xl:gap-10 xl:px-12 xl:py-12"
        >
            <span
                aria-hidden="true"
                class="inline-flex size-14 shrink-0 items-center justify-center rounded-full text-deep-violet xl:size-23"
            >
                <Icon
                    ariaHidden={true}
                    class="text-9 xl:text-home-cta-title"
                    name="security"
                />
            </span>

            <div class="flex min-w-0 flex-1 flex-col gap-4">
                <h3
                    class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal"
                >
                    Customizable security options
                </h3>

                <p
                    class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-graphite xl:text-button-md xl:leading-(--leading-button-md)"
                >
                    Producers can apply customisable security patterns and
                    controls depending on how sensitive the exchanged data is.
                    With Knodia, you can enable request and response signing,
                    ensure synchronisation of updated data and support reliable
                    execution of asynchronous interaction patterns.
                </p>
            </div>
        </article>
    </div>
</section>
