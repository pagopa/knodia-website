---
import Button from '../../Button.astro'
import Icon from '../../Icon'
import heroBackground from '../../../assets/backgrounds/security-hero-background.png'

const whitepaperHref = '#'
---

<section
    aria-labelledby="security-hero-title"
    class="relative isolate overflow-hidden bg-primary-violet-surface"
>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <img
            alt=""
            class="size-full object-cover object-[62%_center] md:object-[60%_center] xl:object-center"
            decoding="async"
            fetchpriority="high"
            height={heroBackground.height}
            loading="eager"
            src={heroBackground.src}
            width={heroBackground.width}
        />
    </div>

    <div
        class="relative mx-auto flex min-h-170 max-w-(--header-shell-max) items-start px-(--header-mobile-padding-x) pt-34 pb-20 md:min-h-180 md:px-(--home-hero-inline-padding-md) md:pt-42 md:pb-24 xl:min-h-200 xl:px-(--header-inline-padding) xl:pt-(--home-hero-padding-top) xl:pb-30"
    >
        <div
            class="flex w-full max-w-[calc(100vw-48px)] flex-col gap-6 sm:max-w-90 md:max-w-140 md:gap-8 xl:max-w-170"
        >
            <span
                class="inline-flex w-fit rounded-sm bg-secondary-soft-quartz px-2 py-1 font-body text-[16px] leading-[24px] font-medium tracking-[0] text-deep-violet"
            >
                SECURITY
            </span>

            <div class="flex flex-col gap-5 xl:gap-6">
                <h1
                    class="font-heading text-hero-sm leading-hero-sm font-semibold tracking-hero-sm text-neutral-graphite md:text-home-cta-title md:leading-17 md:tracking-[-0.84px] xl:text-hero-lg xl:leading-hero-lg xl:tracking-hero-lg"
                    id="security-hero-title"
                >
                    Security by design for trusted interactions
                </h1>

                <p
                    class="max-w-full font-body text-intro-sm leading-intro-sm font-normal text-neutral-graphite md:max-w-140 md:text-home-use-case-title-sm md:leading-[30px] xl:max-w-170 xl:text-intro-lg xl:leading-intro-lg"
                >
                    Knodia protects cross-border interaction through
                    cryptographic trust, verifiable exchange and a privacy-first
                    design.
                </p>

                <Button
                    class="text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet!"
                    href={whitepaperHref}
                    variant="naked"
                >
                    <span class="inline-flex items-center gap-(--button-gap)">
                        <span
                            class="font-body text-button-md leading-(--leading-button-md) font-medium"
                        >
                            Read the whitepaper
                        </span>
                        <Icon ariaHidden={true} name="open_in_new" />
                    </span>
                </Button>
            </div>
        </div>
    </div>
</section>
