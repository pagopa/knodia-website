---
import Button from '../../Button.astro'
import Icon from '../../Icon'

type StandardCard = {
    title: string
    description: string
}

const topRowCards: StandardCard[] = [
    {
        title: 'OpenAPI',
        description:
            'Knodia Producers define the behavior of their cross-border e-services, and the resources they make available through their Knode, using the OpenAPI Specification.',
    },
    {
        title: 'OAuth 2.0',
        description:
            'OAuth 2.0 is the standard used by Knodia to authorize secure access to protected resources by issuing access tokens for cross-border e-services.',
    },
    {
        title: 'Client authentication',
        description:
            'Knodia uses the client authentication mechanism defined in OAuth to identify clients requesting an access token for a cross-border e-service published in the Knode catalogue.',
    },
]

const bottomRowCards: StandardCard[] = [
    {
        title: 'Bearer token',
        description:
            'Knodia Producers can allow access to their cross-border e-services, and to the resources they make available through Knodia, by requiring a bearer access token issued by a Knode and presented by the Knodia consumer.',
    },
    {
        title: 'DPoP token',
        description:
            'Knodia Producers can allow access to their cross-border e-services, and to the resources they make available through Knodia, by requiring an access token issued by a Knode together with proof of the Knodia consumer’s identity.',
    },
]

const technologyHref = '/technology'
---

<section
    aria-labelledby="security-open-standards-title"
    class="bg-neutral-white"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col items-center gap-8 px-(--header-mobile-padding-x) py-10 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div
            class="flex w-full max-w-171 flex-col items-center gap-6 text-center"
        >
            <h2
                class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                id="security-open-standards-title"
            >
                Open standards at the core
            </h2>

            <span
                aria-hidden="true"
                class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"></span>

            <p
                class="font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                Knodia’s security model is implemented through open standards
                and widely adopted technical specifications.
            </p>
        </div>

        <div class="flex w-full flex-col gap-6">
            <div
                class="grid w-full gap-4 md:grid-cols-2 xl:grid-cols-3 xl:gap-6"
            >
                {
                    topRowCards.map((card) => (
                        <article class="h-full rounded-3xl bg-primary-violet-surface p-6 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-66.75 xl:p-8">
                            <div class="flex h-full flex-col gap-4">
                                <h3 class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                                    {card.title}
                                </h3>

                                <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                                    {card.description}
                                </p>
                            </div>
                        </article>
                    ))
                }
            </div>

            <div
                class="grid w-full gap-4 md:grid-cols-2 xl:mx-auto xl:max-w-191 xl:gap-6"
            >
                {
                    bottomRowCards.map((card) => (
                        <article class="h-full rounded-3xl bg-primary-violet-surface p-6 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-66.75 xl:p-8">
                            <div class="flex h-full flex-col gap-4">
                                <h3 class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                                    {card.title}
                                </h3>

                                <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                                    {card.description}
                                </p>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>

        <Button
            class="text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet!"
            href={technologyHref}
            variant="naked"
        >
            <span class="inline-flex items-center gap-(--button-gap)">
                <span
                    class="font-body text-button-md leading-(--leading-button-md) font-medium"
                >
                    Explore Technology
                </span>
                <Icon ariaHidden={true} name="arrow_forward" />
            </span>
        </Button>
    </div>
</section>
