---
import Button from '../../Button.astro'
import Icon from '../../Icon'

type SecurityDesignCard = {
    icon: 'encrypted' | 'handshake' | 'database'
    title: string
    description: string
}

const cards: SecurityDesignCard[] = [
    {
        icon: 'encrypted',
        title: 'Privacy by design',
        description:
            'Data is always exchanged directly between producer and consumer: no one else know the content of the interaction.',
    },
    {
        icon: 'handshake',
        title: 'Trust between Knodes',
        description:
            'Each Knode can recognize and trust the others, creating a secure foundation for cross-border interactions.',
    },
    {
        icon: 'database',
        title: 'Data sovereignty',
        description:
            'Data remains under the control of the domains that govern it, rather than being centralised in a single intermediary layer.',
    },
]

const governanceHref = '/governance'
---

<section aria-labelledby="security-design-title" class="bg-neutral-white">
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col items-center gap-8 px-(--header-mobile-padding-x) py-10 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div class="flex max-w-171 flex-col items-center gap-6 text-center">
            <h2
                class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                id="security-design-title"
            >
                Security starts with how the system is designed
            </h2>

            <span
                aria-hidden="true"
                class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"></span>

            <p
                class="font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:text-intro-lg xl:leading-intro-lg"
            >
                Knodia embeds security into the way domains connect, interact
                and exchange data across borders.
            </p>
        </div>

        <div class="grid w-full gap-4 md:grid-cols-2 xl:grid-cols-3 xl:gap-6">
            {
                cards.map((card) => (
                    <article class="h-full rounded-3xl bg-neutral-white p-6 shadow-(--shadow-what-is-knodia-audience-card) xl:min-h-66.75 xl:p-8">
                        <div class="flex h-full flex-col gap-4 xl:gap-6">
                            <span
                                aria-hidden="true"
                                class="inline-flex size-12 items-center justify-center rounded-full bg-secondary-soft-quartz text-primary-violet"
                            >
                                <Icon
                                    ariaHidden={true}
                                    class="text-6"
                                    name={card.icon}
                                />
                            </span>

                            <h3 class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                                {card.title}
                            </h3>

                            <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                                {card.description}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>

        <Button
            class="text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet!"
            href={governanceHref}
            variant="naked"
        >
            <span class="inline-flex items-center gap-(--button-gap)">
                <span
                    class="font-body text-button-md leading-(--leading-button-md) font-medium"
                >
                    Explore Governance
                </span>
                <Icon ariaHidden={true} name="arrow_forward" />
            </span>
        </Button>
    </div>
</section>
