---
import Button from '../../Button.astro'
import Icon from '../../Icon'
import type { IconName } from '../../Icon'

type SemanticCard = {
    icon: IconName
    title: string
    description: string
}

const semanticCards: SemanticCard[] = [
    {
        icon: 'folder_shared',
        title: 'Federated Attributes',
        description:
            'Shared properties used to describe organizations and define the access conditions that apply across domains.',
    },
    {
        icon: 'category',
        title: 'Federated Categories',
        description:
            'Shared categories used to classify e-services and make discovery more consistent across domains.',
    },
    {
        icon: 'speaker_notes',
        title: 'Controlled vocabularies',
        description:
            'Standardised terms and definitions that preserve a shared meaning across the federation, even when rendered in different domain languages.',
    },
]

const whyKnodiaHref = '/why-knodia'
---

<section
    aria-labelledby="governance-semantic-alignment-title"
    class="bg-primary-violet-surface"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-10 px-(--header-mobile-padding-x) pt-10 pb-12 md:px-(--home-hero-inline-padding-md) xl:gap-20 xl:px-(--header-inline-padding) xl:pt-32 xl:pb-32"
    >
        <div
            class="flex w-full flex-col gap-8 xl:grid xl:grid-cols-[minmax(0,513px)_minmax(0,621px)] xl:items-start xl:gap-6"
        >
            <div class="flex flex-col gap-6 xl:gap-8">
                <h2
                    class="font-heading text-home-support-title-sm leading-home-support-title-sm font-medium text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg xl:font-normal"
                    id="governance-semantic-alignment-title"
                >
                    <span class="block">Semantic alignment</span>
                    <span class="block">across domains</span>
                </h2>

                <span
                    aria-hidden="true"
                    class="h-1 w-16 rounded-full bg-primary-violet xl:w-24"
                ></span>
            </div>

            <div class="xl:flex xl:justify-end">
                <p
                    class="max-w-(--home-domains-copy-width-mobile) font-body text-intro-sm leading-intro-sm font-normal text-neutral-medium-gray xl:max-w-(--home-domains-copy-width) xl:text-intro-lg xl:leading-intro-lg"
                >
                    Knodia also depends on shared semantic elements, so
                    services, categories and access conditions can be understood
                    in the same way across domains.
                </p>
            </div>
        </div>

        <div class="grid w-full gap-4 md:grid-cols-2 xl:grid-cols-3 xl:gap-6">
            {
                semanticCards.map((card) => (
                    <article class="rounded-3xl bg-neutral-white p-6 shadow-[0px_4px_8px_rgba(14,15,19,0.1)] md:last:col-span-2 xl:min-h-66.75 xl:p-8 xl:last:col-span-1">
                        <div class="flex h-full flex-col gap-4">
                            <span
                                aria-hidden="true"
                                class="inline-flex size-12 items-center justify-center rounded-full bg-secondary-soft-quartz text-primary-violet"
                            >
                                <Icon
                                    ariaHidden={true}
                                    class="text-[24px]"
                                    name={card.icon}
                                />
                            </span>

                            <h3 class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal">
                                {card.title}
                            </h3>

                            <p class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-medium-gray xl:text-button-md xl:leading-(--leading-button-md)">
                                {card.description}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>

        <div
            class="flex w-full flex-col gap-5 rounded-3xl bg-primary-light-violet p-6 md:p-8 xl:flex-row xl:items-center xl:gap-10 xl:p-12"
        >
            <div
                aria-hidden="true"
                class="inline-flex size-14 shrink-0 items-center justify-center text-deep-violet xl:size-23"
            >
                <Icon
                    ariaHidden={true}
                    class="text-home-cta-title"
                    name="graph_5"
                />
            </div>

            <div class="flex min-w-0 flex-1 flex-col gap-4">
                <h3
                    class="font-heading text-home-use-case-title-sm leading-home-use-case-title-sm font-medium text-neutral-graphite xl:text-heading-md xl:leading-heading-md xl:font-normal"
                >
                    Less complexity, more coordination
                </h3>

                <p
                    class="font-body text-home-domains-body-sm leading-home-domains-body-sm font-normal text-neutral-graphite xl:text-button-md xl:leading-(--leading-button-md)"
                >
                    By separating what needs to be shared from what can remain
                    local, Knodia makes cross-domain interaction easier to
                    manage, maintain and scale over time.
                </p>

                <Button
                    class="text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet!"
                    href={whyKnodiaHref}
                    variant="naked"
                >
                    <span class="inline-flex items-center gap-(--button-gap)">
                        <span
                            class="font-body text-home-domains-link-sm leading-home-domains-link-sm font-medium xl:text-button-md xl:leading-(--leading-button-md)"
                        >
                            Why Knodia
                        </span>
                        <Icon ariaHidden={true} name="arrow_forward" />
                    </span>
                </Button>
            </div>
        </div>
    </div>
</section>
