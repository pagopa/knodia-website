---

---

<section
    aria-labelledby="prototype-access-access-requirements-title"
    class="bg-primary-violet-surface"
>
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col gap-10 px-(--header-mobile-padding-x) py-16 md:px-(--home-hero-inline-padding-md) md:py-20 xl:gap-20 xl:px-(--header-inline-padding) xl:py-32"
    >
        <div class="flex max-w-128.25 flex-col gap-8">
            <h2
                class="font-heading text-heading-md leading-heading-md font-normal text-neutral-graphite xl:text-heading-lg xl:leading-heading-lg"
                id="prototype-access-access-requirements-title"
            >
                Access requirements
            </h2>
            <span
                aria-hidden="true"
                class="h-1 w-24 rounded-full bg-primary-violet"></span>
        </div>

        <ul
            class="grid list-none grid-cols-1 gap-6 p-0 xl:grid-cols-2 xl:gap-12"
        >
            <li>
                <article
                    class="flex min-h-66.75 flex-col gap-4 rounded-3xl bg-neutral-white p-8 shadow-(--shadow-what-is-knodia-audience-card)"
                >
                    <h3
                        class="font-heading text-home-support-title-sm leading-[32px] font-normal text-neutral-graphite"
                    >
                        For Italian users
                    </h3>
                    <p
                        class="font-body text-button-md leading-(--leading-button-md) font-normal text-neutral-medium-gray"
                    >
                        A digital identity credential such as SPID or CieID is
                        required.
                    </p>
                </article>
            </li>

            <li>
                <article
                    class="flex min-h-66.75 flex-col gap-4 rounded-3xl bg-neutral-white p-8 shadow-(--shadow-what-is-knodia-audience-card)"
                >
                    <h3
                        class="font-heading text-home-support-title-sm leading-[32px] font-normal text-neutral-graphite"
                    >
                        For non-Italian users
                    </h3>
                    <p
                        class="font-body text-button-md leading-(--leading-button-md) font-normal text-neutral-medium-gray"
                    >
                        <span>A digital identity credential </span>
                        <span class="text-primary-violet underline">
                            supported in Italy through the eIDAS Network
                        </span>
                        <span> is required.</span>
                    </p>
                </article>
            </li>
        </ul>
    </div>
</section>
