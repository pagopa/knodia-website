---
import Button from '../../Button.astro'
import resourcesUseCaseSingleFigma from '../../../assets/backgrounds/resources-use-case-single-figma.png'

const viewAllHref = '#'
const readMoreHref = '#'

const tags = ['DATA SYNCHRONIZATION']
---

<section aria-labelledby="resources-use-case-title" class="bg-neutral-white">
    <div
        class="mx-auto flex w-full max-w-(--header-shell-max) flex-col px-(--header-mobile-padding-x) pt-10 pb-10 md:px-(--home-hero-inline-padding-md) md:pt-14 md:pb-14 xl:px-(--header-inline-padding) xl:pt-32 xl:pb-32"
    >
        <div class="flex items-center justify-between">
            <p
                class="text-(length:--text-home-use-case-caption-sm) leading-(--leading-home-use-case-caption-sm) font-medium tracking-[1.2px] text-neutral-medium-gray uppercase xl:text-(length:--text-home-use-case-caption) xl:leading-(--leading-home-use-case-caption) xl:tracking-normal"
            >
                USE CASE
            </p>

            <Button
                class="text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet! xl:[&>span]:gap-(--button-gap)"
                href={viewAllHref}
                icon="arrow_forward"
                size="small"
                variant="naked"
            >
                <span
                    class="text-(length:--text-home-use-case-top-link-sm) leading-(--leading-home-use-case-top-link-sm) font-medium xl:text-button-md xl:leading-(--leading-button-md)"
                >
                    View all
                </span>
            </Button>
        </div>

        <div
            class="mt-8 flex flex-col gap-8 xl:mt-16 xl:grid xl:grid-cols-[minmax(0,571px)_minmax(0,507px)] xl:items-end xl:justify-between xl:gap-x-20 xl:gap-y-0"
        >
            <div
                class="flex flex-col gap-10 xl:min-h-105 xl:justify-between xl:py-4"
            >
                <div class="flex flex-col gap-6">
                    <div class="flex flex-wrap items-center gap-4">
                        {
                            tags.map((tag) => (
                                <span class="inline-flex h-9.25 items-center justify-center rounded-3xl border border-primary-violet px-4 font-caption text-home-use-case-tag leading-home-use-case-tag font-semibold text-primary-violet uppercase">
                                    {tag}
                                </span>
                            ))
                        }
                    </div>

                    <h2
                        class="font-heading text-home-support-title-sm leading-home-support-title-sm font-normal text-neutral-graphite md:text-heading-md md:leading-heading-md xl:text-heading-lg xl:leading-heading-lg"
                        id="resources-use-case-title"
                    >
                        Keeping local data aligned with a base register
                    </h2>

                    <p
                        class="font-body text-button-sm leading-(--leading-button-sm) font-normal text-neutral-graphite md:text-button-md md:leading-(--leading-button-md)"
                    >
                        Knodia supports situations where one-time access to data
                        is not enough and local systems need to stay up to date
                        with a trusted source.
                    </p>
                </div>

                <Button
                    aria-label="Read more about keeping local data aligned with a base register"
                    class="self-start text-primary-violet! hover:text-primary-violet-hover! focus-visible:outline-offset-4 focus-visible:outline-primary-violet active:text-deep-violet! xl:[&>span]:gap-(--button-gap)"
                    href={readMoreHref}
                    icon="arrow_forward"
                    size="small"
                    variant="naked"
                >
                    <span
                        class="text-home-domains-link-sm leading-home-domains-link-sm font-medium xl:text-button-md xl:leading-(--leading-button-md)"
                    >
                        Read more
                    </span>
                </Button>
            </div>

            <div
                class="relative h-64 w-full overflow-hidden rounded-3xl bg-primary-violet-surface md:h-80 xl:h-105 xl:w-126.75"
            >
                <img
                    alt=""
                    class="size-full object-cover"
                    decoding="async"
                    height={resourcesUseCaseSingleFigma.height}
                    loading="lazy"
                    src={resourcesUseCaseSingleFigma.src}
                    width={resourcesUseCaseSingleFigma.width}
                />
            </div>
        </div>
    </div>
</section>
